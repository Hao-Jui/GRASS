+                              rotation_law_const_j, rotation_law_uryu, set_shoot_context, &
+                              uryu_coefficients, ctx_rho_equator_h, ctx_gama_equator_h, &
+                              ctx_ww_equator_h, ctx_rho_pole_h, ctx_gama_pole_h
